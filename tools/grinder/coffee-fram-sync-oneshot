#!/usr/bin/env bash
# coffee-fram-sync-oneshot — do the whole FRAM sync in one command.
# Assumes you've just put the grinder into OWNER MODE (hold both buttons
# while flipping the rear switch on). Runs quickly enough to beat the
# ~2-minute no-client AP timeout.
#
# Sequence:
#   1. Join grinder AP (password auto-pulled from keychain)
#   2. Run coffee-fram-sync (pulls fram.bin, scps to refuge, backfills)
#   3. Cycle WiFi so Mac rejoins its usual network
#
# Total time: ~70 seconds (dominated by the 65s FRAM regen on the grinder).
# Needs no sudo. Ethernet keeps refuge/internet alive throughout.
#
# Invoked from the iOS Shortcut via SSH as well as from the Mac terminal.

set -uo pipefail

# Ensure ~/.local/bin is on PATH when invoked from a non-interactive shell
# (e.g. SSH exec from the iOS Shortcut) where .zshrc isn't sourced.
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

WIFI_IF=${WIFI_IF:-en1}
GRINDER_SSID=${GRINDER_SSID:-E65GbW240216879-240216879}

say() { printf '► %s\n' "$*"; }
die() { printf '✗ %s\n' "$*" >&2; exit "${2:-1}"; }

# Ensure the radio is on — a prior idle-probe might have left it off.
say "ensuring WiFi power on"
networksetup -setairportpower "$WIFI_IF" on >/dev/null 2>&1 || true
sleep 1

# Capture starting SSID so restore() can tell the difference between
# "script joined the grinder" (actively rejoin home on exit)
# and "user manually joined the grinder before running this" (leave it
# alone — the user is debugging and wants to stay on the AP).
INITIAL_SSID=$(networksetup -getairportnetwork "$WIFI_IF" 2>/dev/null \
               | sed -n 's/^Current Wi-Fi Network: //p')

# Fallback home SSID if we weren't associated at start: the first entry
# in the preferred-networks list. macOS orders that list by priority,
# so the top one is the strongest "please rejoin this" preference.
HOME_SSID_FALLBACK=$(networksetup -listpreferredwirelessnetworks "$WIFI_IF" 2>/dev/null \
                     | sed -n '2p' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

# Restore sequence on exit — actively drive the rejoin instead of trusting
# macOS to auto-reassociate. We've observed `off → 2s → on` leaving the
# Mac unassociated for minutes: scan cache stays empty after programmatic
# WiFi manipulation. The fix is to re-flush, let the scan populate, then
# explicitly `-setairportnetwork` to home with retries until it sticks.
# Skip entirely when the user started on the grinder (debugging path).
restore() {
  if [ "$INITIAL_SSID" = "$GRINDER_SSID" ]; then
    say "started on grinder AP — leaving WiFi as-is"
    return
  fi
  local target="${INITIAL_SSID:-$HOME_SSID_FALLBACK}"
  say "restoring WiFi (target: ${target:-<none, will cycle and hope>})"
  networksetup -setairportpower "$WIFI_IF" off >/dev/null 2>&1 || true
  sleep 3
  networksetup -setairportpower "$WIFI_IF" on >/dev/null 2>&1 || true
  sleep 5  # let fresh scan populate before -setairportnetwork
  if [ -z "$target" ]; then
    say "no home SSID known — macOS will pick a preferred network on its own"
    return
  fi
  local waits="3 5 8 13 21"  # ~50s total, Fibonacci-ish
  for w in $waits; do
    JOIN=$(networksetup -setairportnetwork "$WIFI_IF" "$target" 2>&1 || true)
    if ! echo "$JOIN" | grep -qi "failed"; then
      say "rejoined $target"
      return
    fi
    sleep "$w"
  done
  say "could not rejoin $target after ~50s — click the WiFi menu bar icon to pick it manually"
}
trap restore EXIT

# Flush WiFi scan cache before the join loop. Without this, when the
# oneshot runs via SSH from the Shortcut, `networksetup -setairportnetwork`
# fails with Error -3900 (tmpErr: network not found in scan cache) on
# the first several attempts — the cache can hold stale results for
# ~minutes. A power-cycle forces a fresh scan that reliably picks up
# the grinder AP. Skip when the user is already on the grinder (we'd
# just evict ourselves).
if [ "$INITIAL_SSID" != "$GRINDER_SSID" ]; then
  say "flushing WiFi scan cache (off/on, ~5s) so grinder AP is visible"
  networksetup -setairportpower "$WIFI_IF" off >/dev/null 2>&1 || true
  sleep 2
  networksetup -setairportpower "$WIFI_IF" on >/dev/null 2>&1 || true
  sleep 3  # let the fresh scan populate before -setairportnetwork
fi

say "joining grinder AP: $GRINDER_SSID (waiting up to ${JOIN_TIMEOUT_SEC:-180}s for owner mode)"
JOIN_TIMEOUT_SEC=${JOIN_TIMEOUT_SEC:-180}
JOIN_INTERVAL_SEC=${JOIN_INTERVAL_SEC:-5}
START=$(date +%s)
JOINED=""
while [ $(( $(date +%s) - START )) -lt "$JOIN_TIMEOUT_SEC" ]; do
  JOIN=$(networksetup -setairportnetwork "$WIFI_IF" "$GRINDER_SSID" 2>&1 || true)
  if ! echo "$JOIN" | grep -qi "failed"; then
    JOINED=1
    break
  fi
  elapsed=$(( $(date +%s) - START ))
  say "  AP not visible yet (${elapsed}s elapsed) — retrying in ${JOIN_INTERVAL_SEC}s"
  sleep "$JOIN_INTERVAL_SEC"
done
if [ -z "$JOINED" ]; then
  die "AP never appeared within ${JOIN_TIMEOUT_SEC}s — owner mode may not be active" 2
fi
say "joined after $(( $(date +%s) - START ))s"
sleep 2

say "running coffee-fram-sync"
coffee-fram-sync || die "coffee-fram-sync failed" 3

say "sync complete — WiFi will restore on exit"
