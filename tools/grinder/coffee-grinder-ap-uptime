#!/usr/bin/env bash
# coffee-grinder-ap-uptime — measure how long the grinder's diagnostic
# AP stays up after owner-mode activation.
#
# Usage:
#   1. Power the grinder on in owner mode (hold both buttons).
#   2. Join its WiFi from this Mac.
#   3. Run this script. Walk away.
#   4. When /info stops responding, the script prints the duration and exits.
#
# Logs each probe to ~/Library/Logs/coffee-grinder-ap-uptime.log

GRINDER_IP=${GRINDER_IP:-192.168.4.1}
INTERVAL=${INTERVAL:-60}         # seconds between probes
LOG=$HOME/Library/Logs/coffee-grinder-ap-uptime.log

START_EPOCH=$(date +%s)
start_iso=$(date -u +%Y-%m-%dT%H:%M:%SZ)

printf '[%s] uptime probe starting (grinder=%s, probe every %ss)\n' \
  "$start_iso" "$GRINDER_IP" "$INTERVAL" | tee -a "$LOG"

while curl -sS --max-time 5 "http://${GRINDER_IP}/info" >/dev/null 2>&1; do
    elapsed=$(( $(date +%s) - START_EPOCH ))
    mins=$(( elapsed / 60 ))
    secs=$(( elapsed % 60 ))
    printf '[%s] alive, %dm %ds elapsed\n' \
      "$(date -u +%H:%M:%SZ)" "$mins" "$secs" | tee -a "$LOG"
    sleep "$INTERVAL"
done

elapsed=$(( $(date +%s) - START_EPOCH ))
mins=$(( elapsed / 60 ))
secs=$(( elapsed % 60 ))
end_iso=$(date -u +%Y-%m-%dT%H:%M:%SZ)
printf '[%s] AP down after %dm %ds (started %s)\n' \
  "$end_iso" "$mins" "$secs" "$start_iso" | tee -a "$LOG"
