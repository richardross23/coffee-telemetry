<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rwross.coffee-fram-sync-poll</string>

    <!-- Poll every 15 minutes. The script debounces at 12h so this is cheap. -->
    <key>StartInterval</key>
    <integer>900</integer>

    <!-- Don't fire on launchd start — only on the interval -->
    <key>RunAtLoad</key>
    <false/>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/rwross/.local/bin/coffee-fram-sync-poll</string>
    </array>

    <!-- PATH explicitly set so coffee-fram-sync (also in ~/.local/bin) is found -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/rwross/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Logs land in ~/Library/Logs/ for easy inspection -->
    <key>StandardOutPath</key>
    <string>/Users/rwross/Library/Logs/coffee-fram-sync-poll.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rwross/Library/Logs/coffee-fram-sync-poll.log</string>
</dict>
</plist>
